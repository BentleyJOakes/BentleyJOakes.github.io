{% comment %}
  Renders a video, either a local file or an embedded YouTube video.

  Parameters:
    path    - required. A local file (mp4/webm/ogg) or a YouTube URL in any of
              the watch, youtu.be, or embed forms.
    title   - optional. Used as the iframe title, which screen readers announce.
    caption - optional. Rendered as a figcaption below the video.
    class   - optional. Extra classes on the video/iframe element.
    poster, autoplay, controls, loop, muted - local video files only.

  YouTube URLs are normalised to the privacy-preserving nocookie embed host.
  This matters beyond privacy: watch and youtu.be URLs are served with
  `X-Frame-Options: SAMEORIGIN`, so embedding them in an iframe fails outright.
{% endcomment %}

{% assign extension = include.path | split: '.' | last %}
{% assign is_local = false %}
{% if extension == 'mp4' or extension == 'webm' or extension == 'ogg' %}
  {% assign is_local = true %}
{% endif %}

{% assign video_src = include.path %}
{% unless is_local %}
  {% assign youtube_id = '' %}
  {% if include.path contains '/embed/' %}
    {% assign youtube_id = include.path | split: '/embed/' | last | split: '?' | first %}
  {% elsif include.path contains 'youtu.be/' %}
    {% assign youtube_id = include.path | split: 'youtu.be/' | last | split: '?' | first %}
  {% elsif include.path contains 'v=' %}
    {% assign youtube_id = include.path | split: 'v=' | last | split: '&' | first %}
  {% endif %}
  {% if youtube_id != '' %}
    {% assign video_src = 'https://www.youtube-nocookie.com/embed/' | append: youtube_id %}
  {% endif %}
{% endunless %}

<figure>
  {% if is_local %}
    <video
      class="video-embed{% if include.class %} {{ include.class }}{% endif %}"
      src="{% if include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.title %}title="{{ include.title }}"{% endif %}
      {% if include.poster %}poster="{{ include.poster }}"{% endif %}
      {% if include.autoplay %}autoplay{% endif %}
      {% if include.controls %}controls{% endif %}
      {% if include.loop %}loop{% endif %}
      {% if include.muted %}muted{% endif %}
    ></video>
  {% else %}
    <iframe
      class="video-embed{% if include.class %} {{ include.class }}{% endif %}"
      src="{{ video_src }}"
      {% if include.title %}title="{{ include.title }}"{% endif %}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  {% endif %}
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
