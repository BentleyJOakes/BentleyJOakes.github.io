<div class="publication-search-toolbar">
  {% if site.bib_search %}
    <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Type to filter">
  {% endif %}
  <div class="publication-search-actions">
    <span id="pub-filter-notice" role="status"></span>
    <button type="button" id="pub-filter-clear" class="publication-clear" style="visibility: hidden;" disabled>Clear filters ×</button>
  </div>
</div>
