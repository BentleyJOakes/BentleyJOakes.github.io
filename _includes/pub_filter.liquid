<div class="pub-filter-bar" role="group" aria-label="Filter publications by research theme">
  <div class="pub-filter-row">
    <button class="pub-filter-btn active" data-tag="all" style="--card-color: #D4AF37; border-left: 3px solid #D4AF37;">
      <span class="filter-label">All</span>
      <span class="filter-desc">Show all publications</span>
    </button>
  </div>
  <div class="pub-filter-row">
    {% for tag in site.data.pub_tags %}
      {% if forloop.index <= 4 %}
        <button class="pub-filter-btn" data-tag="{{ tag.id }}"{% if tag.color %} style="--card-color: {{ tag.color }}; border-left: 3px solid {{ tag.color }};"{% endif %}>
          <span class="filter-label">{{ tag.label }}</span>
          <span class="filter-desc">{{ tag.description }}</span>
        </button>
      {% endif %}
    {% endfor %}
  </div>
  <div class="pub-filter-row">
    {% for tag in site.data.pub_tags %}
      {% if forloop.index > 4 %}
        <button class="pub-filter-btn" data-tag="{{ tag.id }}"{% if tag.color %} style="--card-color: {{ tag.color }}; border-left: 3px solid {{ tag.color }};"{% endif %}>
          <span class="filter-label">{{ tag.label }}</span>
          <span class="filter-desc">{{ tag.description }}</span>
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<p id="pub-filter-empty" style="display: none;">No publications match your search and topic. Try another search or clear the filters.</p>

<script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
